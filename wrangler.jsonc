{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencampus",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPUS",
        "class_name": "CampusRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CampusRoom"
      ]
    }
  ]
}
